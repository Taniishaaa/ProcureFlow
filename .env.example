# Copy to .env (docker compose reads it automatically). Every value has a working default for local demos.
DB_NAME=procureflow
DB_USERNAME=procureflow
DB_PASSWORD=procureflow

# Must be at least 32 characters. CHANGE THIS for anything other than a local demo.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Demo data: users, categories, suppliers and sample requests are created on an EMPTY database only.
SEED_ENABLED=true
SEED_SAMPLE_DATA=true
SEED_PASSWORD=

# Forgot-password has no mail server: when true the reset token is returned in the API response.
# Set to false outside local demos.
EXPOSE_RESET_TOKEN=true
